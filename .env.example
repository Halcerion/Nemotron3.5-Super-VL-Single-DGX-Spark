# Halcerion kit #4 .env.example — copy to .env and edit. Values are defaults.
# Anything start.sh also accepts on the command line wins from real env over this file.

# --- security ---
# HOST=127.0.0.1 = loopback only (keyless is fine there).
# HOST=0.0.0.0 + API_KEY = LAN/tailnet with Bearer auth (openssl rand -hex 24).
# HOST=0.0.0.0 + API_KEY EMPTY = DELIBERATE OPEN bind: start.sh warns loudly
# and the banner shows auth: NONE - the whole LAN (and the tailnet, if up)
# reaches this GPU unauthenticated until you set a key.
# Put values BEFORE any comment; never a trailing comment on the value line —
# it would end up inside the key (MiMo flight 6/7 debugging lesson).
# Both repos are public (not gated): no HF token needed.
HOST=127.0.0.1
API_KEY=

# --- serving (defaults mirror NVIDIA's DGX Spark Quick Start on the model card) ---
PORT=8895                 # kit default; Spark port map: 8888 MiMo | 8891 Laya | 8892 Ornith | 8899 native 27B
                          # (the server binds this port INSIDE the container too; vLLM's
                          #  own default is 8000 - the first-flight publish/listen gotcha)
SERVED_NAME=nemotron-3.5-super-vl
MAX_SEQS=1                # card value is 1 (their tuned shape); 4 = agent-farm mode (same pool, less KV per seq)
SPEC_TOKENS=7             # LiLiCorr dflash draft length (card value 7); 0 = draft OFF (baseline lane)
GPU_MEM_UTIL=0.75         # card value; pool = 0.75 x total unified -> ~91 GiB on 121.6 GiB usable
MAX_MODEL_LEN=114688      # NVIDIA's own Spark serving limit (drafter card); more ctx needs a bigger pool
MAX_BATCHED_TOKENS=8192   # card value

# --- image (stock vLLM — no custom build for this kit) ---
# The card names vllm/vllm-openai:v0.32.0, but that tag is DEAD on Docker Hub
# (404 "tag not found", verified 10/16; '0.32.0' without the v too). The
# card's NIGHTLY pin is live and multi-arch (amd64 + arm64; arm64 layer
# ~10.7 GB, pushed 10/15 by vllmbot). Hash-suffixed name = effectively
# immutable:
IMAGE=vllm/vllm-openai:nightly-3f1bcfd82bb2e93fcd364fc7a5491718453a77e2
# Exact-repro alternative (manifest-list digest; never consults tags):
#   IMAGE=vllm/vllm-openai@sha256:cb9bc64f0f038c2c2ebf13b31248fb87aca40c356c3d20f363be087cfcff1fcd
# Unverified fallback candidates (NOT validated against this model:
#   vllm/vllm-openai:muse-spark-open — multi-arch, arm64-cu130 sibling tags, pushed 10/15
#   NGC: catalog.ngc.nvidia.com/orgs/nvidia/containers/vllm

# --- checkpoints (~73 GiB total: 70 target + 3 drafter) ---
MODEL_REPO=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4
DRAFT_REPO=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4-LiLiCorr
MODELS_DIR=               # defaults to ~/.cache/halcerion/nemotron-3.5-super-vl (main/ + draft/ + vllm-cache/)

# --- memory gate (unified-memory box: OOM = whole-machine freeze) ---
NEED_HOST_GIB=95          # refuse to launch below this MemAvailable (catches another model still resident)
DISK_NEED_GIB=80          # disk gate for the two repos
MIN_MODEL_GIB=65          # completeness gate: main/ must exceed this real-byte size
HEALTH_TIMEOUT=2700       # first run compiles mamba kernels; card says wait for load + compile

# --- house rules (leave unless you know) ---
CONTAINER_NAME=halcerion-nemotron35-spark
FOREGROUND=0              # 1 = ./start.sh stays attached following container logs
STOP_GRACE_S=30           # ./stop.sh grace window for in-flight streams (SIGTERM -> SIGKILL)
